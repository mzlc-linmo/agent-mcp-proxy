# Copy to .env locally; do not commit real credentials.
BRIDGE_UID=65534
BRIDGE_GID=65534
BRIDGE_ADMIN_BIND_IP=127.0.0.1
BRIDGE_ADMIN_PORT=18082
AGENT_DOCKER_NETWORK=agent-backend
ADMIN_USERNAME=admin
# Local-program (stdio) services; the limit counts Feishu processes too.
STDIO_PROCESS_LIMIT=10
STDIO_START_TIMEOUT=300
# Optional: outbound proxy and package mirrors for npx/uvx (leave empty to use the public registries).
STDIO_HTTPS_PROXY=
STDIO_HTTP_PROXY=
STDIO_NO_PROXY=
STDIO_NPM_REGISTRY=
STDIO_PYPI_INDEX=
